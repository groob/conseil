[Unit]
Description=Conseil personal assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
Group=exedev
WorkingDirectory=/var/lib/conseil
StateDirectory=conseil
StateDirectoryMode=0700
EnvironmentFile=/etc/conseil.env
ExecStart=/usr/local/bin/conseil
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/conseil
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
